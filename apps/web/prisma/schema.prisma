datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  email         String       @unique
  role          String       @default("GUEST")
  passwordHash  String       @map("password_hash")
  avatar        String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  devices       Device[]
  files         FileMetadata[]
  activities    Activity[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Device {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  deviceName   String   @map("device_name")
  publicKey    String   @map("public_key")
  agentVersion String   @map("agent_version")
  lastSeen     DateTime @default(now()) @map("last_seen")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files        FileMetadata[]

  @@map("devices")
}

model FileMetadata {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  deviceId     String       @map("device_id")
  parentId     String?      @map("parent_id")
  name         String
  relativePath String       @map("relative_path")
  size         BigInt
  mimeType     String       @map("mime_type")
  extension    String
  isFolder     Boolean      @default(false) @map("is_folder")
  isFavorite   Boolean      @default(false) @map("is_favorite")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  checksum     String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  parent       FileMetadata? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     FileMetadata[] @relation("FolderHierarchy")
  activities   Activity[]

  @@map("file_metadata")
}

model Activity {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  action    String
  fileId    String?       @map("file_id")
  metadata  String?
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      FileMetadata? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@map("activities")
}
